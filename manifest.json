{
  "manifest_version": 3,
  "name": "LCNAF2Wiki",
  "version": "0.1.0",
  "description": "Extracts MARC 100, 400 and 374 fields from LCNAF authority records.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://id.loc.gov/*", "https://www.wikidata.org/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LCNAF2Wiki"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
