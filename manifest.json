{
  "manifest_version": 3,
  "name": "LCNAF2Wiki",
  "version": "0.2.0",
  "description": "Turns an LCNAF authority record into a Wikidata item.",
  "key": "",
  "permissions": ["activeTab", "storage", "identity"],
  "host_permissions": [
    "https://id.loc.gov/*",
    "https://www.wikidata.org/*",
    "https://query.wikidata.org/*",
    "https://meta.wikimedia.org/*"
  ],
  "action": {
    "default_title": "LCNAF2Wiki",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lcnaf2wiki@nulib.northwestern.edu",
      "strict_min_version": "115.0"
    }
  }
}
